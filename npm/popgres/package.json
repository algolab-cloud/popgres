    "url": "git+https://github.com/algolab-cloud/popgres.git"
  },
  "license": "MIT",
  "bin": {
    "popgres": "bin/popgres.js"
  },
  "files": [
    "bin/popgres.js",
    "README.md"
  ],
  "optionalDependencies": {
    "@popgres/darwin-arm64": "0.2.1",
    "@popgres/darwin-x64": "0.2.1",
    "@popgres/linux-arm64": "0.2.1",
    "@popgres/linux-x64": "0.2.1",
    "@popgres/win32-x64": "0.2.1"
  },
  "engines": {
    "node": ">=18"
  }
